# Publication allowlist. Local files and newly added top-level folders stay private.
/*
!/.gitignore
!/.gitattributes
!/readme.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/dependencies.json
!/requirements.txt
!/port.example.json

!/android/
/android/**
!/android/**/
!/android/**/*.c
!/android/**/*.h
!/android/**/*.java
!/android/**/*.xml

!/config/
/config/*
!/config/inputs.json
!/config/seeds.json

!/tools/
/tools/*
!/tools/*.py
# Local audio experiments and receipts tied to historical private builds.
/tools/analyze_pixel_audio.py
/tools/audio_speech_match.py
/tools/verify_native_build.py
/tools/verify_stronghold_release.py

!/tests/
/tests/*
!/tests/*.c
!/tests/*.h
!/tests/*.java
!/tests/*.py

!/reference/
/reference/*
!/reference/dlmalloc/
/reference/dlmalloc/*
!/reference/dlmalloc/malloc.c

# Defense in depth for outputs, credentials and machine settings in source trees.
**/__pycache__/
**/.gradle/
**/build/
**/.idea/
**/.vscode/
*.py[cod]
*.apk
*.aab
*.exe
*.dll
*.so
*.o
*.obj
*.class
*.dex
*.zip
*.7z
*.log
*.keystore
*.jks
*.pem
*.key
.env
.env.*
local.properties
port.json
STATE.md
AGENTS.md
